# 核心配置
GMGN_API_KEY=your_gmgn_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# Worker（扫描间隔，单位秒）
SIGNAL_SCAN_INTERVAL=30


# sqlite | postgres
SIGNAL_DB_DRIVER=sqlite
# PostgreSQL 连接串
SIGNAL_DATABASE_URL=
# 本地 Docker PostgreSQL 示例：
# SIGNAL_DB_DRIVER=postgres
# SIGNAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/automated_trading_meme
# 数据目录（表示本地运行数据目录）
# 不只是数据库，还可能影响日志、默认 sqlite 文件位置、重置脚本的目录扫描
SIGNAL_DATA_DIR=.signal-scan-data
# 自定义 SQLite 数据库文件的 精确路径（不填则默认使用 .signal-scan-data/narrative_history.db）
SIGNAL_SQLITE_PATH=

# Network
# auto: 优先使用 SIGNAL_HTTP_PROXY_URL，其次使用系统 HTTP(S)_PROXY
# on: 强制启用代理
# off: 禁用代理直连
SIGNAL_HTTP_PROXY_MODE=auto # 控制是否走代理
# 指定代理地址
SIGNAL_HTTP_PROXY_URL=  
# 💡 如果后面你把 worker 放到 pm2 、Docker 或服务器上，
# 而那些环境没有继承系统代理变量，就改成显式代理
# 配置：
# SIGNAL_HTTP_PROXY_MODE=on  
# SIGNAL_HTTP_PROXY_URL=http://127.0.0.1:7890


# Telegram delivery（决定 TG 推送失败后怎么重试）
SIGNAL_TG_TIMEOUT_MS=20000  # TG 单次超时毫秒
SIGNAL_TG_MAX_RETRIES=2     # TG 失败重试次数
SIGNAL_TG_RETRY_DELAY_MS=1500   # 每次重试等待毫秒

# 数据保留天数
SIGNAL_DATA_RETENTION_DAYS=15
