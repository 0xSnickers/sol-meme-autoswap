# Core
GMGN_API_KEY=your_gmgn_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TG_CHAT_ID=your_telegram_chat_id

# Worker
SIGNAL_SCAN_INTERVAL=30
SIGNAL_DATA_DIR=.signal-scan-data
# sqlite ｜ supabase
SIGNAL_STORAGE_DRIVER=supabase

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Data retention
# 兼容现有 Supabase 的 radar_* 表结构
SIGNAL_DATA_RETENTION_DAYS=15

# Strategy settings
# 止盈 / 止损 / 时间止损 / trailing 等策略参数，优先在前端策略弹框中调整
# 其余高级参数默认使用内置值，需要时再按需补充到 .env

# Legacy compatibility
# 旧的 RADAR_* 变量仍然可继续使用，但新部署建议统一改用 SIGNAL_*
